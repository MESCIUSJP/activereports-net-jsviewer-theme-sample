<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<RootNamespace>ThemeReportsApp</RootNamespace>
		<AssemblyName>ThemeReportsApp</AssemblyName>
		<TargetFramework>net10.0</TargetFramework>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<EnableDefaultContentItems>false</EnableDefaultContentItems>
		<AspNetCoreHostingModelV2>InProcess</AspNetCoreHostingModelV2>
	</PropertyGroup>
	<ItemGroup>
	  <None Remove="Views\Home\Report1.cshtml" />
	  <None Remove="Views\Shared\_BusinessLayout.cshtml" />
	</ItemGroup>
	<ItemGroup>
		<Content Include="Views\Home\Report1.cshtml" />
		<Content Include="Views\Shared\_BusinessLayout.cshtml" />
		<Content Include="wwwroot\favicon.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="wwwroot\index.css">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="wwwroot\jsViewer.min.css">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="wwwroot\jsViewer.min.js">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="wwwroot\custom-locale.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<ItemGroup>
		<Content Include="ActiveReports.config" />
		<Content Include="ClientApp\package.json" />
		<Content Include="Properties\launchSettings.json" />
		<Content Include="Properties\licenses.licx" />
		<Content Include="Reports\Report.rdlx" />
		<Content Include="Views\Home\Index.cshtml" />
	</ItemGroup>
	<ItemGroup>
		<Compile Include="Controllers\HomeController.cs" />
		<Compile Include="Program.cs" />
		<Compile Include="Startup.cs" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="MESCIUS.ActiveReports.Aspnetcore.Viewer.ja" Version="20.1.1" />
	</ItemGroup>
	<Target Name="BeforeClientBuild" BeforeTargets="BeforeBuild">
		<ReadLinesFromFile File="wwwroot\custom-locale.json">
			<Output TaskParameter="Lines" ItemName="CustomLocale" />
		</ReadLinesFromFile>
		<PropertyGroup>
			<IsEmtry Condition=" '@(CustomLocale)' == '' ">true</IsEmtry>
			<IsEmtry Condition=" '@(CustomLocale)' != '' ">false</IsEmtry>
		</PropertyGroup>
		<MSBuild Projects="$(MSBuildProjectFullPath)" Properties="IsEmtry=$(IsEmtry)" Targets="ClientBuild" />
	</Target>
	<Target Name="ClientBuild" Condition=" '$(IsEmtry)' == 'true'">
		<Exec WorkingDirectory="ClientApp" Command="npm install" />
		<Exec WorkingDirectory="ClientApp" Command="npm run build" />
	</Target>

 </Project>
