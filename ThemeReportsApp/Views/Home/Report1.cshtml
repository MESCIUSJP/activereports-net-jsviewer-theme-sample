@{
    // 業務システムの共通レイアウトを使用します。
    Layout = "_BusinessLayout";
    ViewData["Title"] = "帳票1";
}

<!-- JSビューワを表示する領域 -->
<div class="h-full overflow-hidden rounded-lg border border-[var(--border-color)] bg-[var(--panel-bg)] shadow-sm app-transition">
    <div id="viewerContainer" class="h-full w-full"></div>
</div>

@section Scripts {
    <script type="text/javascript">
        // 業務システムの通常テーマに合わせたカスタムテーマ
        const businessLightTheme = {
            name: "BusinessLight",
            type: "light",
            backgroundMain: "#F1F3F5",
            backgroundPanels: "#FFFFFF",
            primary: "#272F3F",
            secondary: "#475569",
            neutral: "#66717D",
            error: "#B65C66",
            warning: "#A98245",
            fontFamily: "Segoe UI, Meiryo, Arial, sans-serif"
        };

        // 業務システムのダークテーマに合わせたカスタムテーマ
        const businessDarkTheme = {
            name: "BusinessDark",
            type: "dark",
            backgroundMain: "#0D0F12",
            backgroundPanels: "#181B20",
            primary: "#3F4854",
            secondary: "#2E353E",
            neutral: "#A7ADB5",
            error: "#B85C65",
            warning: "#A98245",
            fontFamily: "Segoe UI, Meiryo, Arial, sans-serif"
        };

        // 参考用のMESCIUSカラーのカスタムテーマ
        const mesciusTheme = {
            name: "MESCIUS",
            type: "light",
            backgroundMain: "#EFEDEA",
            backgroundPanels: "#E6E2DD",
            primary: "#697683",
            secondary: "#AF9D52",
            neutral: "#505050",
            error: "#AC6D85",
            warning: "#AF9D52",
            fontFamily: "Segoe UI, Meiryo, Arial, sans-serif"
        };

        const availableThemes = [
            businessLightTheme,
            businessDarkTheme,
            mesciusTheme
        ];

        let viewer;

        // 選択されたテーマを初期テーマに指定してViewerを作り直します。
        function createReportViewer(themeName) {
            if (viewer) {
                // 既存Viewerを破棄して、イベントやDOMの重複を防ぎます。
                viewer.destroy();
            }

            // 再生成前にコンテナーを空にします。
            document.getElementById("viewerContainer").innerHTML = "";

            viewer = GrapeCity.ActiveReports.JSViewer.create({
                element: "#viewerContainer",
                themes: {
                    initialTheme: themeName,
                    // 業務システム側のテーマ選択で切り替えるため、
                    // JSビューワ内のテーマピッカーは無効化しています。
                    themeSelector: {
                        enabled: false,
                        availableThemes: availableThemes
                    }
                }
            });

            // Reportsフォルダーにあるレポート定義を開きます。
            viewer.openReport("Report.rdlx");
        }

        // 業務システムのテーマ変更を受け取り、Viewerへ反映します。
        systemTheme.onChange(createReportViewer);

        // 現在のテーマでViewerを表示します。
        createReportViewer(systemTheme.current());
    </script>
}
